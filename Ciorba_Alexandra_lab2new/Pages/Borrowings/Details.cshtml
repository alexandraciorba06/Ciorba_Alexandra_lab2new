@page
@model Ciorba_Alexandra_lab2new.Pages.Borrowings.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Borrowing</h4>
    <hr />
    <dl class="row">

        <!-- Member -->
        <dt class="col-sm-2">
            Member
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Member.LastName @Model.Borrowing.Member.FirstName
        </dd>

        <!-- Book -->
        <dt class="col-sm-2">
            Book
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Book.Title -
            @Model.Borrowing.Book.Author.LastName @Model.Borrowing.Book.Author.FirstName
        </dd>

        <!-- Return Date -->
        <dt class="col-sm-2">
            Return Date
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Borrowing.ReturnDate)
        </dd>

    </dl>
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Borrowing.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
