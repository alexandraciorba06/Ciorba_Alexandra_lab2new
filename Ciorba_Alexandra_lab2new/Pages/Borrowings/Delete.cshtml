@page
@model Ciorba_Alexandra_lab2new.Pages.Borrowings.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>Borrowing</h4>
    <hr />
    <dl class="row">

        <!-- Member -->
        <dt class="col-sm-2">
            Member
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Member.LastName @Model.Borrowing.Member.FirstName
        </dd>

        <!-- Book -->
        <dt class="col-sm-2">
            Book
        </dt>
        <dd class="col-sm-10">
            @Model.Borrowing.Book.Title -
            @Model.Borrowing.Book.Author.LastName @Model.Borrowing.Book.Author.FirstName
        </dd>

        <!-- Return Date -->
        <dt class="col-sm-2">
            Return Date
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Borrowing.ReturnDate)
        </dd>

    </dl>
</div>

<form method="post">
    <input type="hidden" asp-for="Borrowing.ID" />
    <button type="submit" class="btn btn-danger">Delete</button> |
    <a asp-page="./Index">Back to List</a>
</form>
